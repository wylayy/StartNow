#!/bin/sh
set -e

# StartNow postrm: remove the marked PATH lines added by postinst.

user="${SUDO_USER:-}"
if [ -n "$user" ]; then
    home="$(getent passwd "$user" 2>/dev/null | cut -d: -f6)"
    [ -z "$home" ] && home="/home/$user"
    for rc in "$home/.bashrc" "$home/.zshrc" "$home/.profile"; do
        [ -f "$rc" ] || continue
        sed -i '/# >>> startnow PATH >>>/,/# <<< startnow PATH <<</d' "$rc"
    done
fi

exit 0
